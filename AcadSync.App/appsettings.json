{
    "ConnectionStrings": {
        "AnthologyStudent": "Server=localhost;Database=Anthology_AcadSync;Trusted_Connection=True;TrustServerCertificate=True;",
        "AcadSyncAudit": "Server=localhost;Database=AcadSyncAudit;Trusted_Connection=True;TrustServerCertificate=True;"
    },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "AcadSync": "Debug"
    }
  },
  "AcadSync": {
    "DefaultStaffId": 1,
    "MaxConcurrentOperations": 10,
    "EnableAuditLogging": true,
    "RulesFile": "rules.yaml",
    "AuditRetentionDays": 365,
    "UseReadUncommitted": true,
    "AutoInitializeDatabase": true
  }
}
